# Webhook service - monorepo build (pnpm workspace)
# 2026-02-21: Alpine builder OK; runtime must be Debian for Prisma OpenSSL 3
FROM node:22-alpine AS builder
WORKDIR /app

# Enable pnpm
RUN corepack enable pnpm

# Copy full repo (build context is source_dir: . )
COPY . .

# Ensure workspace config exists (App Platform context may omit it)
RUN printf 'packages:\n  - "apps/*"\n  - "packages/*"\n' > pnpm-workspace.yaml

# Install and build
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @codereview-ai/db run build
RUN pnpm --filter @codereview-ai/webhook-service run build

# Runtime: Debian (OpenSSL 3) - Alpine + Prisma libssl.so.1.1 issues are avoided
FROM node:22-bookworm-slim
WORKDIR /app

# Copy built output and deps (pnpm: root + app node_modules for symlink resolution)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/webhook-service/node_modules ./apps/webhook-service/node_modules
COPY --from=builder /app/apps/webhook-service/dist ./apps/webhook-service/dist
COPY --from=builder /app/apps/webhook-service/package.json ./apps/webhook-service/
COPY --from=builder /app/package.json ./

# Regenerate Prisma client for runtime
RUN cd packages/db && npx prisma generate --schema=./prisma/schema.prisma

ENV PORT=3000
EXPOSE 3000
CMD ["node", "apps/webhook-service/dist/index.js"]
