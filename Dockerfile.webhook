# Webhook service - monorepo build (pnpm workspace)
# 2026-02-21: Alpine builder OK; runtime must be Debian for Prisma OpenSSL 3
FROM node:22-alpine AS builder
WORKDIR /app

# Enable pnpm
RUN corepack enable pnpm

# Copy full repo (build context is source_dir: . )
COPY . .

# Ensure workspace config exists (App Platform context may omit it)
RUN printf 'packages:\n  - "apps/*"\n  - "packages/*"\n' > pnpm-workspace.yaml

# Install and build
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @codereview-ai/db run build
RUN pnpm --filter @codereview-ai/webhook-service run build

# Runtime: Debian - fresh install so Prisma generates correct binary (no Alpine pollution)
FROM node:22-bookworm-slim
RUN apt-get update -y && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Enable pnpm
RUN corepack enable pnpm

# Copy only manifests, lockfile, built output, and schema (no node_modules from Alpine builder)
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/webhook-service/dist ./apps/webhook-service/dist
COPY --from=builder /app/apps/webhook-service/package.json ./apps/webhook-service/package.json

# Fresh install on Debian + generate Prisma with correct binary (no Alpine linux-musl)
RUN pnpm install --frozen-lockfile
RUN cd packages/db && PRISMA_CLI_BINARY_TARGETS=debian-openssl-3.0.x npx prisma generate --schema=./prisma/schema.prisma

ENV PORT=3000
EXPOSE 3000
CMD ["node", "apps/webhook-service/dist/index.js"]
