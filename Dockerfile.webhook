# Webhook service - monorepo build (pnpm workspace)
FROM node:22-alpine AS builder
WORKDIR /app

# Enable pnpm
RUN corepack enable pnpm

# Copy full repo (build context is source_dir: . )
COPY . .

# Ensure workspace config exists (App Platform context may omit it)
RUN printf 'packages:\n  - "apps/*"\n  - "packages/*"\n' > pnpm-workspace.yaml

# Install and build
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @codereview-ai/db run build
RUN pnpm --filter @codereview-ai/webhook-service run build

# Deploy creates a self-contained directory with all production deps
RUN pnpm --filter @codereview-ai/webhook-service deploy --prod /app/deployed

# Runtime stage
FROM node:22-alpine
WORKDIR /app

COPY --from=builder /app/deployed .

ENV PORT=3000
EXPOSE 3000
CMD ["node", "dist/index.js"]
